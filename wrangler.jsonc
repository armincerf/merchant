{
  "name": "merchant",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-01",

  "durable_objects": {
    "bindings": [
      {
        "name": "MERCHANT",
        "class_name": "MerchantDO"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MerchantDO"]
    }
  ],

  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "merchant-images"
    }
  ],

  "vars": {
    "IMAGES_URL": "",
    // Set OAUTH_DEV_LINKS="true" for local dev to render the magic link in the
    // OAuth HTML response (useful when no email service is configured).
    // NEVER set this in production — it would expose sign-in links to anyone
    // who submits the authorization form.
    "OAUTH_DEV_LINKS": ""
  },

  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "dev": {
    "port": 8787
  }
}
